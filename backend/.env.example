# ============================================================
# Voice AI Interview Assistant — Backend Environment Variables
# ============================================================

# --- AI Provider ---
# Set to "openai" or "gemini"
AI_PROVIDER=gemini

# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=

# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=

# --- MongoDB ---
# Local: mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb+srv://rajatverma9494_db_user:Vf6KA9lZF5BFtAH4@voiceinterviewdb.ecjx7qt.mongodb.net/
MONGODB_DB_NAME=voice_interview_db

# --- App Settings ---
# JWT secret for auth
JWT_SECRET=voice-ai-interview-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

MAX_HISTORY_MESSAGES=10

# TTS Engine: "gtts" (online, better quality) or "pyttsx3" (offline)
TTS_ENGINE=gtts
